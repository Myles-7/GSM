# Template only: use Node --env-file with a private copy outside Git.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Required in production. Generate a secret before starting; never commit it.
API_SECRET=
# Optional absolute paths; defaults are cwd/data and DATA_DIR/data.db.
# DATA_DIR=C:/ProgramData/GSM/data
# DB_PATH=C:/ProgramData/GSM/data/data.db
# Keep the original key when restoring encrypted credentials.
# ENCRYPTION_KEY_FILE=C:/ProgramData/GSM/keys/encryption.key
# ENCRYPTION_KEY=
# Optional built SPA directory; unset for API-only deployments.
# STATIC_DIR=C:/path/to/GSM/dist
# Extra browser-direct provider origins, comma-separated.
# CSP_CONNECT_SRC=https://ai.example.com,https://vector.example.com
